# ==============================================================================
# YouTrack MCP Server — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ОБЯЗАТЕЛЬНЫЕ ПАРАМЕТРЫ ПОДКЛЮЧЕНИЯ
# ------------------------------------------------------------------------------

# Базовый адрес вашего инстанса YouTrack (Cloud или Self-Hosted)
# Примеры:
#   YOUTRACK_URL=https://mycompany.youtrack.cloud
#   YOUTRACK_URL=https://yt.fbox.me
#   YOUTRACK_URL=http://localhost:8080
YOUTRACK_URL=https://your-instance.youtrack.cloud

# Постоянный токен авторизации YouTrack (Permanent Token)
# Получение: YouTrack -> Профиль -> Account Security -> Tokens -> New token
# Необходимые права: Read Issue, Write Issue, Read Project, Knowledge Base
# Пример:
#   YOUTRACK_TOKEN=perm:abc123xyz-dummy-token
YOUTRACK_TOKEN=perm:your-permanent-token-here


# ------------------------------------------------------------------------------
# 2. РЕЖИМЫ БЕЗОПАСНОСТИ И ЗАЩИТЫ ДАННЫХ
# ------------------------------------------------------------------------------

# Режим "Только для чтения" (Read-Only)
# false (по умолчанию) = Стандартный режим (разрешены создание, редактирование, списание времени, архивация).
# true = Полная блокировка любых мутаций данных (ИИ может только искать и читать).
# Примеры:
#   YOUTRACK_READ_ONLY=false
#   YOUTRACK_READ_ONLY=true
YOUTRACK_READ_ONLY=false

# ВНИМАНИЕ ПО УДАЛЕНИЮ (Zero Hard-Delete Safety):
# Физическое уничтожение данных (HTTP DELETE) полностью вырезано из кода сервера.
# Инструмент delete_issue ВСЕГДА выполняет безопасную архивацию (Soft-Delete: State Obsolete),
# гарантируя сохранение всей истории, комментариев и файлов.
